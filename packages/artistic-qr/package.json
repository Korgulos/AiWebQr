{
  "name": "artistic-qr",
  "version": "0.1.0",
  "description": "Artistic QR Code generator for JavaScript and TypeScript with image and animated GIF backgrounds, customizable dots, shapes and colors.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker.js": "./dist/worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.txt",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "0.19.12",
    "typescript": "^5.8.3",
    "qrcode-generator": "1.5.2",
    "gifuct-js": "2.1.2",
    "gifenc": "1.0.3"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "artistic",
    "animated",
    "gif",
    "typescript",
    "browser"
  ],
  "author": "Dejan Katic"
}
