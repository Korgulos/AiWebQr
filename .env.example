# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# Required: generate a unique random secret of at least 32 bytes. Never commit real credentials.
JWT_SECRET="replace-with-a-unique-random-secret"

# Optional public client key: enables the embedded GIPHY search picker.
# Create your own web API key at https://developers.giphy.com/dashboard/
PUBLIC_GIPHY_API_KEY=""
